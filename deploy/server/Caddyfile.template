# ThreatFalcon management server: TLS termination in front of the ingest
# listener (443) and the read API (8443). Generated by
# deploy/server/bootstrap.sh; re-running bootstrap overwrites this file.
{
	__TFS_ACME_EMAIL__
	# Port 80 stays closed: no HTTP-to-HTTPS redirects.
	auto_https disable_redirects
	servers :443 {
		timeouts {
			read_header 10s
			read_body 60s
			write 60s
			idle 2m
		}
	}
	servers :8443 {
		timeouts {
			read_header 10s
			read_body 10s
			# Event exports stream for as long as they take.
			write 30m
			idle 2m
		}
	}
}

(tls_acme) {
	tls {
		issuer acme {
			# Port 80 is closed, so validate via TLS-ALPN-01 on 443.
			disable_http_challenge
		}
	}
}

__TFS_DOMAIN__ {
	import tls_acme

	@ingest {
		method POST
		path /api/v1/events
	}
	handle @ingest {
		request_body {
			max_size 16MB
		}
		reverse_proxy 127.0.0.1:8080 {
			# Hold requests while threatfalcon-server restarts (deploys).
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}

	# Everything else (including the admin API and the read API) is not
	# reachable here.
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/threatfalcon-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# Read API (agent status and stored events) for investigation clients. The
# security group opens 8443 only to the addresses in the CloudFormation
# parameter ReaderCidr (closed by default), and every request needs a reader
# token (`threatfalcon-server reader add`).
__TFS_DOMAIN__:8443 {
	import tls_acme
	encode gzip

	@read {
		method GET
		path /healthz /api/v1/agents /api/v1/agents/*
	}
	handle @read {
		reverse_proxy 127.0.0.1:8082
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/threatfalcon-reader-access.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}
