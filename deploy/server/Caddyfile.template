# ThreatFalcon management server: TLS termination in front of the ingest
# listener. Generated by deploy/server/bootstrap.sh; re-running bootstrap
# overwrites this file.
{
	__TFS_ACME_EMAIL__
	# Only the HTTPS ingest endpoint is exposed (port 80 stays closed).
	auto_https disable_redirects
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			write 60s
			idle 2m
		}
	}
}

__TFS_DOMAIN__ {
	tls {
		issuer acme {
			# Port 80 is closed, so validate via TLS-ALPN-01 on 443.
			disable_http_challenge
		}
	}

	@ingest {
		method POST
		path /api/v1/events
	}
	handle @ingest {
		request_body {
			max_size 16MB
		}
		reverse_proxy 127.0.0.1:8080 {
			# Hold requests while threatfalcon-server restarts (deploys).
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}

	# Everything else (including the admin API) is not reachable from outside.
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/threatfalcon-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}
