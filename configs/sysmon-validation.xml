<!-- Controlled validation profile, NOT a production filtering policy.
     全件収集の検証用設定です。ProcessAccess/ImageLoadは大量イベントとなり得ます。
     Review data handling, disk budget, and performance before a pilot.
     Validate the schema with your installed Sysmon version before applying. -->
<Sysmon schemaversion="4.82">
  <HashAlgorithms>sha256</HashAlgorithms>
  <EventFiltering>
    <RuleGroup name="ThreatFalcon validation" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
      <ProcessTerminate onmatch="exclude" />
      <NetworkConnect onmatch="exclude" />
      <CreateRemoteThread onmatch="exclude" />
      <ProcessAccess onmatch="exclude" />
      <ImageLoad onmatch="exclude" />
      <DriverLoad onmatch="exclude" />
      <FileCreate onmatch="exclude" />
      <RegistryEvent onmatch="exclude" />
      <PipeEvent onmatch="exclude" />
      <DnsQuery onmatch="exclude" />
      <ProcessTampering onmatch="exclude" />
    </RuleGroup>
  </EventFiltering>
</Sysmon>
